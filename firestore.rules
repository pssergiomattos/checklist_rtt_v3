rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidInspection(data) {
      return data.keys().hasAll(['serviceId', 'tecnico', 'identificacao', 'createdAt', 'userId'])
        && data.serviceId is string
        && data.tecnico is string
        && data.identificacao is string
        && data.createdAt is number
        && data.userId is string
        && data.userId == request.auth.uid;
    }

    match /inspections/{inspectionId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() 
                    && isValidId(inspectionId)
                    && isValidInspection(incoming());
      // For now we don't need update/delete for inspections
    }
  }
}
