rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      let adminDoc = get(/databases/$(database)/documents/config/admins);
      return request.auth != null && (
        (adminDoc != null && request.auth.token.email in adminDoc.data.list) ||
        request.auth.token.email == 'paulo.matos@rttshop.com.br'
      );
    }

    match /inspections/{inspectionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
    }

    match /userProfiles/{email} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.email == email || isAdmin());
    }

    match /logs/{logId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
